{
  "name": "lab-reservations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lab reservations: a web app and an MCP server over the same service layer.",
  "engines": {
    "node": ">=22"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "migrate": "node src/db/migrate.js",
    "mcp": "node --env-file-if-exists=.env mcp-server/server.js",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage",
    "test": "npm run test:unit && node mcp-server/check.mjs -- npm run --silent mcp"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.0"
  }
}
